# --- fusion_bench 子目录早期遗留 ---
/fusion_bench/fusion_bench.egg-info/
/fusion_bench/datasets/
/fusion_bench/.cache/
/fusion_bench/hub/
/fusion_bench/outputs/
/fusion_bench/outputs*/

# --- HuggingFace evaluate metric runtime metadata (auto-generated, contains
# absolute paths from the machine that ran evaluate.load); the .py modules
# next to it are kept as an offline backup, only the .json is excluded. ---
fusion_bench/modules/evaluate_modules/metrics/**/*.json
