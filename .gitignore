# --- 内嵌第三方 fork 的独立 .git（绝对不能进主仓）---
**/InternVL/.git/
**/LLaMA-Factory/.git/
**/lmms-eval/.git/
**/VLMEvalKit/.git/
**/ModelCompose/.git/

# --- 实验产物 / 缓存 ---
/outputs/
/outputs*/
/results/
/temp/
mlruns/
lightning_logs/
wandb/
profile_report.html
*.log
*.out
*.err
*.pid

# --- HuggingFace / lm-eval / VLMEvalKit 数据缓存 ---
/.cache/
/hub/
/datasets/
/LMUData/

# --- 大模型 / 数据二进制 ---
*.safetensors
*.bin
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.arrow
*.parquet
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pickle
*.zip
*.tar
*.tar.gz
*.tgz

# --- Python / pip ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.python-version
.venv/
venv/

# --- 测试 / lint 缓存 ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- 编辑器 / OS ---
.DS_Store
Thumbs.db
.idea/
.cursorignore
.cursorindexingignore
.claude/settings.local.json
.vscode/launch.json
.vscode/settings.json
*.code-workspace

# --- 凭证（永远不能 push）---
.env
.env.local
.env.*
!.env.template

