# =============================================================================
# Environment template for sensitive credentials and feature flags
# -----------------------------------------------------------------------------
# Usage:
#   1. Copy this file:           cp .env.template .env.local
#   2. Fill in real values in:   .env.local         (gitignored, never commit)
#   3. Source before running:    source .env.local
#
# Non-secret runtime variables (REPO_ROOT, HF_HOME, LMUData, TOKENIZERS_PARALLELISM,
# CUDA_VISIBLE_DEVICES, ...) are documented in README.md §3 and should be exported
# directly from your shell, not put here.
# =============================================================================

# Hugging Face token — required for gated repos such as meta-llama/Llama-3.2-*
# (see README.md §5.3 Llama-3.2-3B MergeBench reproduction).
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=${HF_TOKEN}

# OpenAI-compatible API for the GPT judge used by MathVista_MINI / MathVision_MINI
# under VLMEvalKit (see README.md §5.4.3). Any provider that exposes
# /v1/chat/completions works (OpenAI, Azure OpenAI, vLLM, ...).
# Leave both empty if you do not need MathVista/MathVision evaluation.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Required by lm_eval to run code-generation tasks (humaneval_plus, mbpp_plus).
# These tasks execute generated code in a sandbox; setting this to "1" is the
# explicit acknowledgement required by lm_eval. See README.md §5.3.
HF_ALLOW_CODE_EVAL=1
